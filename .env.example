# Core application
QUERYGUARD_ENVIRONMENT=development
QUERYGUARD_DATABASE_PATH=data/chinook/Chinook_Sqlite.sqlite
QUERYGUARD_WORKSPACE_ROOT=data/workspaces
QUERYGUARD_WORKSPACE_TTL_MINUTES=120
QUERYGUARD_MAX_UPLOAD_MB=50
QUERYGUARD_MAX_TOTAL_UPLOAD_MB=100
QUERYGUARD_MAX_UPLOAD_FILES=10
QUERYGUARD_MAX_OFFICE_UNCOMPRESSED_MB=120

# Choose one: demo, ollama, gemini, groq
QUERYGUARD_LLM_PROVIDER=demo

# Local/offline LLM
QUERYGUARD_OLLAMA_BASE_URL=http://localhost:11434
QUERYGUARD_OLLAMA_MODEL=qwen2.5-coder:7b
QUERYGUARD_OLLAMA_TIMEOUT_SECONDS=120

# Hosted Gemini
QUERYGUARD_GEMINI_API_KEY=
QUERYGUARD_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
QUERYGUARD_GEMINI_MODEL=gemini-3.5-flash
QUERYGUARD_GEMINI_THINKING_LEVEL=low
QUERYGUARD_GEMINI_TIMEOUT_SECONDS=60

# Hosted Groq
QUERYGUARD_GROQ_API_KEY=
QUERYGUARD_GROQ_BASE_URL=https://api.groq.com/openai/v1
QUERYGUARD_GROQ_MODEL=qwen/qwen3.6-27b
QUERYGUARD_GROQ_TIMEOUT_SECONDS=60

# Hosted UI -> API shared secret. Leave empty for local-only development.
QUERYGUARD_API_ACCESS_KEY=

# Retrieval and query safety
QUERYGUARD_RETRIEVAL_STRATEGY=lexical
QUERYGUARD_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
QUERYGUARD_TOP_K_TABLES=5
QUERYGUARD_DOCUMENT_TOP_K=5
QUERYGUARD_MAX_RESULT_ROWS=200
QUERYGUARD_QUERY_TIMEOUT_MS=5000
QUERYGUARD_ENABLE_REPAIR=true
QUERYGUARD_LOG_LEVEL=INFO

# Streamlit frontend only
QUERYGUARD_API_URL=http://localhost:8000
